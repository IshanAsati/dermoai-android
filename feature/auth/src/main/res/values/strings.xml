    <!-- ── Verification status ─────────────────────────────────────────────
         Wording is intentionally flat. "Pending" must not read as a near-miss
         for "Verified", because until a human says otherwise the claim is
         simply unchecked. -->
    <string name="doctor_status_verified">Verified</string>
    <string name="doctor_status_pending">Awaiting review</string>
    <string name="doctor_status_unverified">Not submitted</string>
    <string name="doctor_status_rejected">Not approved</string>

    <string name="doctor_status_title">Verification</string>
    <string name="doctor_status_subtitle">Where your professional account stands</string>
    <string name="doctor_status_pending_body">A reviewer checks your registration number against your medical council\'s register by hand. This is not automatic and there is no way to speed it up from the app.</string>
    <string name="doctor_status_unverified_body">We have no credentials on file for this account yet, so there is nothing to review. Submit them to start the process.</string>
    <string name="doctor_status_rejected_body">A reviewer could not confirm these credentials. This usually means the registration number did not match the name on the register. Contact support to correct your details and be reviewed again.</string>
    <string name="doctor_status_allowed_title">What you can do now</string>
    <string name="doctor_status_allowed_scan">Use every patient-side feature: scans, timeline, routines and reports for your own skin.</string>
    <string name="doctor_status_allowed_profile">Correct your submitted details by contacting support.</string>
    <string name="doctor_status_blocked_title">What you cannot do yet</string>
    <string name="doctor_status_blocked_patients">See any patient\'s scans, photos or notes — including patients who invite you.</string>
    <string name="doctor_status_blocked_invites">Accept care invitations or appear to patients as a verified clinician.</string>
    <string name="doctor_status_blocked_reason">These stay locked because an unreviewed claim is not evidence, and the data behind them is someone else\'s medical history.</string>
    <string name="doctor_status_credentials_title">Submitted credentials</string>
    <string name="doctor_status_credentials_readonly">Read-only. Changes go through the same review, so support edits them for you.</string>
    <string name="doctor_status_empty">No credentials on file for this account.</string>
    <string name="doctor_status_contact_support">Contact support</string>
    <string name="doctor_status_sign_out">Sign out</string>
    <string name="doctor_status_not_provided">Not provided</string>
    <!-- Debug builds only. Never composed in a release build. -->
    <string name="doctor_status_debug_note">Debug build: review is out-of-band, so this shortcut stands in for a reviewer. It is not present in a release build.</string>
    <string name="doctor_status_debug_approve">Approve this claim (debug only)</string>
