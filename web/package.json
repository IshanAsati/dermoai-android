{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify-doctor": "node --env-file=.env.local scripts/verify-doctor.mjs",
    "test:e2e": "playwright test",
    "test:contract": "node tests/contract/appwrite-contract.mjs fake",
    "test:all": "vitest run && node tests/contract/appwrite-contract.mjs fake && playwright test",
    "test:live": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test -c playwright.live.config.ts",
    "demo": "node scripts/demo.mjs up",
    "demo:phone": "node scripts/demo.mjs phone"
  },
  "dependencies": {
    "next": "16.4.6",
    "node-appwrite": "^31.2.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
